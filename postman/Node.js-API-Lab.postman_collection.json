{
  "info": {
    "name": "Node.js API Lab",
    "description": "Requests for the HTTP-based demos in Node.js API Lab. Set apiBaseUrl to http://localhost. WebSocket, gRPC, and SSE are demonstrated with the browser examples and npm scripts in the repository README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "apiBaseUrl",
      "value": "http://localhost",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "REST",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}:3001/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns users', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user 1",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}:3001/users/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns user', () => pm.response.to.have.status(200));",
                  "pm.test('User has a name', () => pm.expect(pm.response.json().name).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amina\",\n  \"email\": \"amina@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3001/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates user', () => pm.response.to.have.status(201));",
                  "pm.test('Returns created user', () => pm.expect(pm.response.json().id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user 1",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"name\": \"John Updated\"\\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3001/users/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updates user', () => pm.response.to.have.status(200));",
                  "pm.test('Name is updated', () => pm.expect(pm.response.json().name).to.eql('John Updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete user 2",
          "request": {
            "method": "DELETE",
            "url": "{{apiBaseUrl}}:3001/users/2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deletes user', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ users { id name email } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3002/graphql"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GraphQL request succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Returns users', () => pm.expect(pm.response.json().data.users).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { addUser(name: \\\"Amina\\\", email: \\\"amina@example.com\\\") { id name email } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3002/graphql"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mutation succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Returns created user', () => pm.expect(pm.response.json().data.addUser.name).to.eql('Amina'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "SOAP-style XML",
      "item": [
        {
          "name": "Get user (XML)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\"?>\\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\\n  <soap:Body>\\n    <GetUser><UserId>1</UserId></GetUser>\\n  </soap:Body>\\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3003/soap"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SOAP-style request succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Response contains user name', () => pm.expect(pm.response.text()).to.include('John Example'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "JSON-RPC",
      "item": [
        {
          "name": "Add numbers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"add\",\n  \"params\": {\n    \"a\": 10,\n    \"b\": 20\n  },\n  \"id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3005/rpc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RPC request succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('10 + 20 equals 30', () => pm.expect(pm.response.json().result).to.eql(30));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Send order.created event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order.created\",\n  \"data\": {\n    \"orderId\": \"ORD-1001\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}:3006/webhooks/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Webhook accepted', () => pm.response.to.have.status(202));",
                  "pm.test('Accepted flag is true', () => pm.expect(pm.response.json().accepted).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
